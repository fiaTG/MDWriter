<?xml version="1.0" encoding="utf-8"?>
<!--
==================================================================
demo_documents.xml — Beispieldaten für Demo-Instanzen
==================================================================
Diese Datei wird NUR geladen wenn Odoo im Demo-Modus läuft
(z.B. auf Odoo.sh in einer neuen Entwicklungsinstanz).

Sie ruft eine Python-Methode auf, die drei Beispiel-Dokumente
mit echtem Markdown-Inhalt anlegt — damit man das Modul sofort
ohne manuelle Dateneingabe vorführen kann.

noupdate="1":
  Odoo lädt diese Daten nur EINMAL (beim ersten Installieren).
  Bei späteren Modul-Updates werden sie NICHT überschrieben.
  Gut: Demo-Daten, die der User bearbeitet hat, bleiben erhalten.

<function model="..." name="..."/>:
  Ruft eine Python-Methode auf dem angegebenen Modell auf.
  Äquivalent zu: self.env["x.md.document"]._demo_dokumente_anlegen()
  Die Methode ist mit @api.model dekoriert und in md_document.py definiert.
==================================================================
-->
<odoo>
    <data noupdate="1">
        <function model="x.md.document" name="_demo_dokumente_anlegen"/>
    </data>
</odoo>
