<?xml version="1.0" encoding="UTF-8"?>
<!--
==================================================================
md_document_views.xml — Benutzeroberfläche des Moduls
==================================================================
Odoo-Views beschreiben, WIE Daten im Browser angezeigt werden.
Die eigentlichen Daten liegen im Python-Modell — Views sind nur
die "Schablone" für die Darstellung.

Grundstruktur:
  <record id="..." model="ir.ui.view">
    → legt einen View-Datensatz in der Datenbank an
    → Odoo lädt ihn automatisch für das passende Modell

Wichtigste View-Typen:
  form   → Einzelansicht eines Datensatzes (Detail-Formular)
  list   → Tabellen-/Listenansicht aller Datensätze
  search → Suchmaske mit Filtern und Gruppierungen

Das <arch>-Feld enthält das XML-Gerüst der View.
type="xml" sagt Odoo: dieser Inhalt ist XML, nicht Text.
==================================================================
-->
<odoo>
    <!-- ==============================================================
         FORM VIEW: Einzelansicht eines Markdown-Dokuments
         Erscheint wenn ein User auf einen Eintrag in der Liste klickt.
         ============================================================== -->
    <record id="view_md_document_form" model="ir.ui.view">
        <field name="name">x.md.document.form</field>
        <field name="model">x.md.document</field>
        <field name="arch" type="xml">
            <form string="Markdown‑Dokument">
                <sheet>
                    <!--
                    <header>: der Status-Bereich ganz oben im Formular.
                    Enthält Aktions-Buttons und die Statusleiste.

                    <button>-Attribute:
                      name="..."   → Name der Python-Methode, die aufgerufen wird
                      type="object" → ruft eine Methode auf dem Modell auf
                      string="..."  → Beschriftung des Buttons
                      invisible="..." → Python-Ausdruck: Button verstecken wenn True
                        z.B. invisible="state == 'published'" bedeutet:
                        "Zeige den Button NICHT wenn state bereits 'published' ist"
                      class="btn-primary" → blauer Haupt-Button (Bootstrap-Klasse)
                    -->
                    <header>
                        <button name="aktion_veroeffentlichen" type="object" string="Veröffentlichen"
                            invisible="state == 'published'" class="btn-primary"/>
                        <button name="aktion_als_entwurf" type="object" string="Zurück zu Entwurf"
                            invisible="state == 'draft'"/>
                        <button name="aktion_archivieren" type="object" string="Archivieren"
                            invisible="state == 'archived'"/>
                        <button name="aktion_pdf_exportieren" type="object" string="Als PDF exportieren"
                            invisible="not current_version"/>
                        <button name="aktion_md_herunterladen" type="object" string="Markdown herunterladen"
                            invisible="not current_version"/>
                        <!--
                        widget="statusbar": zeigt die Status-Schritte als Fortschrittsleiste an.
                        statusbar_visible: welche Schritte angezeigt werden (nicht alle müssen sichtbar sein).
                        -->
                        <field name="state" widget="statusbar" statusbar_visible="draft,published,archived"/>
                    </header>

                    <!-- Dokumenttitel: oe_title gibt den Odoo-typischen Titel-Stil -->
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Dokumenttitel"/></h1>
                    </div>

                    <!--
                    widget="markdown_editor": verwendet unsere eigene OWL-Komponente
                    statt des Standard-Textfeldes. Registriert in markdown_editor.js.
                    nolabel="1": kein Label-Text vor dem Feld anzeigen.
                    -->
                    <field name="content_md" widget="markdown_editor" nolabel="1"/>

                    <!--
                    <notebook>: erzeugt Tabs (Reiter) im Formular.
                    <page>: ein einzelner Tab.
                    -->
                    <notebook>
                        <page string="Metadaten" name="metadata">
                            <!--
                            <group>: ordnet Felder in zwei Spalten an (left/right).
                            Verschachtelte <group> → linke und rechte Spalte.
                            readonly="1": Feld kann nicht bearbeitet werden.
                            -->
                            <group>
                                <group>
                                    <field name="owner_id" readonly="1"/>
                                    <field name="current_version" readonly="1"/>
                                </group>
                                <group>
                                    <field name="create_date" readonly="1"/>
                                    <field name="write_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Versionen" name="versions">
                            <div class="mb-2">
                                <!-- Öffnet den Diff-Wizard als Popup-Fenster -->
                                <button name="aktion_diff_anzeigen" type="object" string="Versionen vergleichen" class="btn btn-secondary btn-sm"/>
                            </div>
                            <!--
                            readonly="1": Die gesamte Versions-Liste ist nur lesbar.
                            <list>: Unteransicht in Tabellenform innerhalb des Formulars.
                            -->
                            <field name="version_ids" readonly="1">
                                <list string="Versionen">
                                    <field name="version" string="Version"/>
                                    <field name="changed_by" string="Geändert von"/>
                                    <field name="changed_at" string="Geändert am"/>
                                    <field name="checksum" string="Checksumme"/>
                                    <field name="md_attachment_id" string="Markdown"/>
                                    <field name="pdf_attachment_id" string="PDF"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <!-- ==============================================================
         LIST VIEW: Tabellen-Übersicht aller Dokumente
         Erscheint als Startseite der App.
         ============================================================== -->
    <record id="view_md_document_list" model="ir.ui.view">
        <field name="name">x.md.document.list</field>
        <field name="model">x.md.document</field>
        <field name="arch" type="xml">
            <!--
            <list>: jedes <field> wird eine Spalte in der Tabelle.
            widget="many2one_avatar_user": zeigt Avatar-Bild des Benutzers.
            widget="badge": zeigt den Status als farbiges Label.
            decoration-success="...": grünes Badge wenn Bedingung wahr ist.
            decoration-warning="...": oranges Badge.
            widget="date": zeigt nur das Datum (ohne Uhrzeit).
            -->
            <list string="Markdown‑Dokumente" class="o_md_document_list">
                <field name="name"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                    decoration-success="state == 'published'"
                    decoration-warning="state == 'archived'"/>
                <field name="current_version"/>
                <field name="write_date" widget="date"/>
            </list>
        </field>
    </record>

    <!-- ==============================================================
         SEARCH VIEW: Suchmaske mit Filtern und Gruppierungen
         Erscheint in der Suchleiste oben rechts in der Listenansicht.
         ============================================================== -->
    <record id="view_md_document_search" model="ir.ui.view">
        <field name="name">x.md.document.search</field>
        <field name="model">x.md.document</field>
        <field name="arch" type="xml">
            <search string="Markdown‑Dokumente">
                <!-- <field>: durchsuchbare Felder (Volltextsuche) -->
                <field name="name"/>
                <field name="owner_id"/>
                <separator/>
                <!--
                <filter>: vordefinierte Filter-Schaltflächen.
                domain: SQL WHERE-Bedingung als Python-Liste.
                name: interner Name des Filters.
                -->
                <filter string="Entwürfe" name="draft_filter" domain="[('state', '=', 'draft')]"/>
                <filter string="Veröffentlicht" name="published_filter" domain="[('state', '=', 'published')]"/>
                <filter string="Archiviert" name="archived_filter" domain="[('state', '=', 'archived')]"/>
                <separator/>
                <!-- uid ist eine Odoo-Variable: die ID des eingeloggten Nutzers -->
                <filter string="Meine Dokumente" name="my_docs" domain="[('owner_id', '=', uid)]"/>
                <separator/>
                <!--
                context mit group_by: Datensätze nach diesem Feld gruppieren.
                Erscheint im UI als "Gruppierung hinzufügen"-Option.
                -->
                <filter string="Nach Status" name="group_state" context="{'group_by': 'state'}"/>
                <filter string="Nach Eigentümer" name="group_owner" context="{'group_by': 'owner_id'}"/>
            </search>
        </field>
    </record>

    <!-- ==============================================================
         VERSION FORM VIEW: Einzelansicht einer Version (read-only)
         Öffnet sich wenn User auf eine Version in der Versions-Liste klickt.
         ============================================================== -->
    <record id="view_md_document_version_form" model="ir.ui.view">
        <field name="name">x.md.document.version.form</field>
        <field name="model">x.md.document.version</field>
        <field name="arch" type="xml">
            <!--
            create="false" edit="false" delete="false":
            Verhindert, dass der User Versionen anlegen, bearbeiten oder löschen kann.
            Versions-Records sind append-only — nur der Python-Code darf sie anlegen.
            -->
            <form string="Version" create="false" edit="false" delete="false">
                <header>
                    <!--
                    confirm="...": zeigt einen Bestätigungs-Dialog bevor die Aktion ausgeführt wird.
                    Schützt vor versehentlichem Klicken.
                    -->
                    <button name="aktion_wiederherstellen" type="object" string="Wiederherstellen" class="btn-primary" confirm="Möchtest du das Dokument auf diese Version zurücksetzen? Eine neue Version wird automatisch angelegt."/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h2><field name="version" string="Version" readonly="1"/></h2>
                    </div>
                    <group>
                        <group>
                            <field name="changed_by" readonly="1"/>
                            <field name="changed_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="checksum" readonly="1"/>
                        </group>
                    </group>
                    <group string="Anhänge">
                        <field name="md_attachment_id" readonly="1"/>
                        <field name="pdf_attachment_id" readonly="1"/>
                    </group>
                    <separator string="Markdown‑Inhalt"/>
                    <!-- readonly="1": Versions-Inhalt kann nicht bearbeitet werden -->
                    <field name="content_md" widget="markdown_editor" nolabel="1" readonly="1" class="o_full_width"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ==============================================================
         ACTION: Was passiert wenn der Menüpunkt geklickt wird
         ============================================================== -->
    <record id="action_md_document" model="ir.actions.act_window">
        <field name="name">Markdown‑Dokumente</field>
        <field name="res_model">x.md.document</field>
        <!-- view_mode: welche Views sind verfügbar (Reihenfolge = Reihenfolge im UI) -->
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_md_document_search"/>
        <!--
        help: Nachricht wenn die Liste leer ist (kein Dokument vorhanden).
        type="html": Inhalt wird als HTML gerendert.
        -->
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Erstelle dein erstes Markdown‑Dokument!
            </p>
            <p>
                Mit dieser App kannst du Markdown‑Dokumente erstellen, live bearbeiten
                und Versionen verwalten. Jede Änderung wird automatisch versioniert
                und mit einem Audittrail versehen.
            </p>
        </field>
    </record>

    <!-- ==============================================================
         MENÜ-EINTRÄGE
         menuitem: erzeugt einen Eintrag im Odoo-Navigationsmenü.
         sequence: steuert die Reihenfolge (kleiner = weiter oben/vorne).
         web_icon: Icon das im Odoo-Homescreen angezeigt wird.
         ============================================================== -->

    <!-- Haupt-Eintrag in der Top-Navigation -->
    <menuitem id="menu_md_document_root" name="Markdown" sequence="20" web_icon="markdown_editor,static/description/icon.png"/>

    <!-- Untermenü-Eintrag: öffnet die Dokument-Liste -->
    <menuitem id="menu_md_document" name="Dokumente" parent="menu_md_document_root" action="action_md_document" sequence="10"/>
</odoo>
